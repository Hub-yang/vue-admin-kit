{
  "name": "@huberyyang/shared-components",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "共享组件库",
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/*": "./src/styles/*"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "catalog:",
    "element-plus": "catalog:",
    "lodash-es": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "dependencies": {
    "@huberyyang/shared-unocss": "workspace:*",
    "@huberyyang/shared-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "async-validator": "catalog:"
  }
}
